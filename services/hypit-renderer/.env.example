# Hypit rendering backend — configuration template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed:
# it holds the API token. Provider credentials (HypiHub OAuth, Ark API key) are
# NOT here — Hypit keeps them in the OS credential store.

# --- Shared token for this HTTP API -------------------------------------------
# Required. Generate with:  openssl rand -hex 32
HYPIT_API_TOKEN=replace-me
HYPIT_API_TOKEN_HEADER=X-API-Token

# --- Listen address ----------------------------------------------------------
HYPIT_HOST=127.0.0.1
HYPIT_PORT=8787
HYPIT_LOG_LEVEL=INFO

# --- Hypit executable and project --------------------------------------------
# HYPIT_BIN default is the globally installed CLI. On this machine prefer the
# checkout launcher: the npm package @hypit/hypit@0.1.8 still declares
# `workspace:*` dependencies, so a Worker started from that tree cannot resolve
# @hypit/hyperframes / @hyperframes/engine and every local render fails.
# Evidence: docs/ACCEPTANCE.md.
HYPIT_BIN=/Users/xiangyu/Doubao/skills/hypit-repo/hypit
HYPIT_CWD=/Users/xiangyu/Doubao/skills/hypit-repo

# The project whose Runtime Profile is used. `hypit` resolves the project from
# the nearest package.json above HYPIT_CWD and rejects sources outside it, so an
# out-of-tree project must be named here.
# Paths are relative to this service directory — the project moved here from the
# scratch `hypit-backend/` directory it was first built in.
HYPIT_WORKSPACE=./smoke
HYPIT_RUNTIME_PROFILE=./smoke/hypit.runtime.json
# HYPIT_PACKAGE_ROOT=

# --- macOS 26 `ps` workaround ------------------------------------------------
# Leave on for macOS. macOS 26 blocks spawning /bin/ps from Node child processes;
# Hypit's local renderer shells out to `ps` to reap its process tree, so without
# this shim every local render fails with "Render cleanup failed; Error: spawn EPERM".
# Set to 0 in a Linux image — there the system `ps` is correct, and the shim
# (a Mach-O binary) must not be used.
HYPIT_PS_SHIM=1
# HYPIT_PS_SHIM_DIR=<project>/bin

# --- Worker warm-up ----------------------------------------------------------
# Start the Build Worker during the lifespan handshake rather than on the first
# Build. Leave on under an orchestrator: /health reports ok=false while the
# Worker is stopped, so a readiness probe would never let the pod receive the
# Build that would start it. A failed warm-up is non-fatal.
HYPIT_RUNTIME_WARMUP=1
HYPIT_RUNTIME_WARMUP_TIMEOUT_SECONDS=60

# --- Request handling --------------------------------------------------------
HYPIT_SUBMIT_BLOCK_SECONDS=15
HYPIT_SUBMIT_TIMEOUT_SECONDS=300
HYPIT_QUERY_TIMEOUT_SECONDS=120
HYPIT_PLAN_TIMEOUT_SECONDS=300
HYPIT_DOWNLOAD_TIMEOUT_SECONDS=600
HYPIT_MAX_CONCURRENT_SUBMISSIONS=2

# --- Sources -----------------------------------------------------------------
# Colon-separated extra roots a `source` may resolve inside. HYPIT_WORKSPACE and
# HYPIT_CWD are always allowed.
# HYPIT_ALLOWED_SOURCE_ROOTS=/Users/xiangyu/Doubao/skills/hypit-repo
HYPIT_ALLOWED_SOURCE_SUFFIXES=.svml,.svs,.svrun
# Inline `content` sources are written here; must stay inside an allowed root.
# HYPIT_UPLOAD_DIR=./smoke/_uploads
HYPIT_MAX_SOURCE_BYTES=2097152

# --- Exports -----------------------------------------------------------------
# HYPIT_EXPORT_DIR=<project>/outputs
HYPIT_EXPORT_TTL_SECONDS=86400
HYPIT_STATE_DIR=
