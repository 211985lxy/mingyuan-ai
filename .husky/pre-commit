# pre-commit: 提交前轻量检查（typecheck + 秒级门禁，约 6-8 秒）
#
# 设计原则：快、不打扰、本地复现 CI 最常打回的几项。
# - 只在改了 .ts/.tsx 时跑；改文档/md 时直接放行
# - 跑的检查都是秒级，不会让你等烦
# - 紧急可 --no-verify 跳过（不推荐，会让坏代码进仓）
# - 推送前想要完整检查：make preflight（typecheck+lint+全量测试）

# 1. 只看暂存（已 git add）的文件里，有没有 .ts/.tsx
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -z "$STAGED_TS" ]; then
  exit 0  # 没改代码（只改了文档/配置），直接放行
fi

cd apps/web

# 2. typecheck（约 4 秒）—— 拦住类型错误，最常被 CI 打回
echo "── pre-commit: typecheck ──"
pnpm typecheck || { echo "✗ typecheck 失败，修完再提交（--no-verify 可跳过）"; exit 1; }

# 3. 秒级门禁（各 0-1 秒）—— 你历史上反复被这几项打回
echo "── pre-commit: 秒级门禁 ──"
pnpm arch:size     || { echo "✗ arch:size 失败（有文件超 800 行？），修完再提交"; exit 1; }
pnpm api:contracts || { echo "✗ api:contracts 失败（API 契约不一致？）"; exit 1; }
pnpm env:check     || { echo "✗ env:check 失败（环境变量缺失？）"; exit 1; }

echo "✓ pre-commit 全过（typecheck + arch:size + api:contracts + env:check）"
