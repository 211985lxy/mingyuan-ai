{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@mingyuan/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["src-tauri/target/release/bundle/**"],
      "cache": false,
      "env": ["MINGYUAN_WEB_URL"]
    },
    "@mingyuan/desktop#dev": {
      "cache": false,
      "persistent": true
    }
  }
}
