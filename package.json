{
  "name": "mingyuan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "release:context": "node scripts/check-release-context.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "security:audit": "node scripts/check-dependency-audit.mjs",
    "dev": "turbo dev --filter='./apps/*'",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "pnpm --filter @mingyuan/web dev",
    "dev:desktop": "pnpm --filter @mingyuan/desktop dev",
    "build:desktop": "pnpm --filter @mingyuan/desktop build",
    "icon:desktop": "pnpm --filter @mingyuan/desktop icon"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.62.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "husky": "^9.1.7",
    "release-it": "^19.2.4",
    "turbo": "^2"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25",
      "undici": "6.27.0",
      "vite": "8.0.16",
      "js-yaml": ">=5.2.2",
      "fast-uri": ">=3.1.4",
      "brace-expansion": ">=5.0.8",
      "next": "16.2.11",
      "postcss": ">=8.5.18",
      "nanoid": "3.3.17"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
