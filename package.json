{
  "name": "mingyuan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "release:context": "node scripts/check-release-context.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "audit:event": "node scripts/audit-event.mjs",
    "test:audit-event": "node --test scripts/audit-event.test.mjs",
    "security:audit": "node scripts/check-dependency-audit.mjs",
    "dev": "turbo dev --filter='./apps/*'",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "pnpm --filter @mingyuan/web dev",
    "dev:desktop": "pnpm --filter @mingyuan/desktop dev",
    "build:desktop": "pnpm --filter @mingyuan/desktop build",
    "icon:desktop": "pnpm --filter @mingyuan/desktop icon"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.59.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "husky": "^9.1.7",
    "release-it": "^19.2.4",
    "turbo": "^2"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "brace-expansion": ">=5.0.12",
      "browserslist": ">=4.28.7",
      "deepmerge-ts": "8.0.0",
      "fast-uri": ">=4.1.3",
      "hono": "4.12.25",
      "ip-address": ">=10.7.0",
      "js-yaml": ">=5.2.2",
      "mariadb": ">=3.4.6",
      "mysql2": ">=3.22.0",
      "nanoid": "3.3.18",
      "axios": "1.20.0",
      "basic-ftp": "6.2.2",
      "handlebars": "4.7.10",
      "next": "16.3.8",
      "postcss": ">=8.5.18",
      "proxy-addr": "2.0.8",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "undici": "6.29.0",
      "urllib": "2.44.1",
      "vite": "8.0.16",
      "vm2": "-"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
