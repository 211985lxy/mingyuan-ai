  "smoke:ip-loop": "tsx --tsconfig tsconfig.json scripts/aim-ip-loop-smoke.ts",
  "start": "next start",
  "test": "vitest run --config vitest.config.ts",
  "test:component": "vitest run --config vitest.component.config.ts",
  "test:e2e": "vitest run --config vitest.e2e.config.ts",
  "test:e2e:ip-loop": "vitest run --config vitest.ip-loop.config.ts",
  "test:e2e:prepare": "tsx scripts/e2e-database.ts prepare",
  "test:e2e:real-llm": "vitest run --config vitest.real-llm.config.ts",
  "test:e2e:reset": "tsx scripts/e2e-database.ts reset",
  "test:harness": "vitest run __tests__/eval/ __tests__/unit/aim-harness-core.test.ts __tests__/unit/aim-admin-runs-route.test.ts",
  "test:mobile": "node scripts/mobile-responsive-check.mjs",
  "test:unit": "vitest run --config vitest.config.ts",
  "test:watch": "vitest",
  "typecheck": "tsc --noEmit",
  "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
 },
