{
  "name": "@mingyuan/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "test:mobile": "node scripts/mobile-responsive-check.mjs",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:real-llm": "vitest run --config vitest.real-llm.config.ts",
    "test:e2e:prepare": "tsx scripts/e2e-database.ts prepare",
    "test:e2e:reset": "tsx scripts/e2e-database.ts reset",
    "test:watch": "vitest",
    "test:harness": "vitest run __tests__/eval/ __tests__/unit/aim-harness-core.test.ts __tests__/unit/aim-admin-runs-route.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "eval:deterministic": "DATABASE_URL='mysql://eval:eval@127.0.0.1:3306/aim_eval' tsx --tsconfig tsconfig.json scripts/aim-eval.ts --deterministic",
    "eval:daily": "tsx --tsconfig tsconfig.json scripts/aim-eval.ts --daily",
    "eval:full": "tsx --tsconfig tsconfig.json scripts/aim-eval.ts --full",
    "arch:check": "tsx --tsconfig tsconfig.json scripts/check-aim-architecture.ts",
    "longfn:report": "tsx --tsconfig tsconfig.json scripts/count-long-functions.ts",
    "longfn:baseline": "tsx --tsconfig tsconfig.json scripts/count-long-functions.ts --write-baseline",
    "longfn:check": "tsx --tsconfig tsconfig.json scripts/count-long-functions.ts --enforce",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:contracts": "node scripts/api-inventory.mjs --check",
    "arch:size": "node scripts/check-source-file-size.mjs",
    "arch:retired": "node scripts/check-retired-capabilities.mjs",
    "arch:domains": "node scripts/check-domain-boundaries.mjs",
    "db:bounds": "node scripts/check-prisma-query-bounds.mjs",
    "arch:size:report": "node scripts/check-source-file-size.mjs --report",
    "schema:verify": "node scripts/verify-production-schema.mjs",
    "schema:migration-status": "prisma migrate status",
    "schema:migration-integrity": "node scripts/check-migration-integrity.mjs",
    "schema:retired-media-preflight": "node scripts/check-retired-media-data.mjs",
    "backup:database": "node scripts/backup-database.mjs",
    "backup:verify": "node scripts/verify-database-backup.mjs",
    "env:check": "node scripts/check-env-contract.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@t3-oss/env-nextjs": "^0.13.8",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.3.6",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.8.0",
    "mcp-handler": "1.1.0",
    "mysql2": "^3.15.3",
    "next": "16.2.11",
    "next-intl": "^4.8.3",
    "openai": "^6.32.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "prisma": "^7.5.0",
    "prom-client": "^15.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "shadcn": "^4.0.8",
    "sonner": "^2.0.7",
    "styled-jsx": "^5.1.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "6.27.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  }
}
