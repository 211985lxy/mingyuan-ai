// Content domain models

model Script {
  id               String    @id @default(cuid())
  userId           String
  content          String    @db.Text
  sourceTemplateId String?
  generationRunId  String?
  ipProfileId      String?
  structureId      String?
  status           String    @default("draft") // draft | candidate | selected | discarded
  qualityScore     Float?
  qualityMetadata  Json?
  selectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Phase 14: Copywriting Engine ──
  topicSelectionId  String?
  isHotTopicVersion Boolean @default(false)

  // ── Quality Gate (PRD Module 4) ──
  openingTypeCode String? // 使用的开头类型代码
  structureCode   String? // 使用的文案结构代码
  endingTypeCode  String? // 使用的结尾类型代码
  qualityReport   Json? // 四维评分详情 { editorial, aiTaste, attraction, logic }
  rewriteCount    Int     @default(0) // 自动重写次数

  user          User                  @relation(fields: [userId], references: [id])
  generationRun ContentGenerationRun? @relation(fields: [generationRunId], references: [id])
  ipProfile     IpProfile?            @relation(fields: [ipProfileId], references: [id])
  structure     VideoStructure?       @relation(fields: [structureId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([generationRunId])
  @@index([ipProfileId])
  @@index([structureId])
  @@index([topicSelectionId])
}

model ContentGenerationRun {
  id                String   @id @default(cuid())
  userId            String
  ipProfileId       String
  templateId        String
  structureId       String?
  structureSnapshot Json?
  hotTopicId        String?
  hotTopic          String?
  hotTopicInsight   Json?
  hotTopicFit       Json?
  inputsJson        Json
  promptText        String   @db.Text
  model             String
  status            String   @default("succeeded") // pending | succeeded | failed | degraded
  qualityScore      Float?
  qualityMetadata   Json?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ── Phase 14: Copywriting Engine (Topic Selection context) ──
  topicSelectionId  String?
  openingTypeCode   String?
  copyStructureCode String?
  endingTypeCode    String?

  user      User            @relation(fields: [userId], references: [id])
  ipProfile IpProfile       @relation(fields: [ipProfileId], references: [id])
  structure VideoStructure? @relation(fields: [structureId], references: [id])
  scripts   Script[]

  @@index([userId, createdAt])
  @@index([templateId])
  @@index([structureId])
  @@index([hotTopicId])
  @@index([topicSelectionId])
}

model HotTopicFitCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  topicId     String
  topicTitle  String
  templateId  String
  structureId String
  ipProfileId String
  fitJson     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topicId, templateId, structureId])
  @@index([ipProfileId, updatedAt])
}

model VideoStructure {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  subtitle    String?
  description String?  @db.Text
  useCase     String?
  blueprint   Json // Machine-readable: openingPattern, narrativeBeats, evidenceSlots, ctaSlot, durationRange
  sortOrder   Int      @default(0)
  status      String   @default("published") // draft | published | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scripts               Script[]
  contentGenerationRuns ContentGenerationRun[]

  @@index([status, sortOrder])
}

model TopicElement {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  typeLabel     String
  description   String   @db.Text
  conflictCodes Json     @default("[]")
  sortOrder     Int      @default(0)
  status        String   @default("published")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, sortOrder])
}

model OpeningType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @db.Text
  formulas    Json
  examples    Json     @default("[]")
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

model CopyStructure {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @db.Text
  beats       Json
  caseStudy   Json     @default("[]")
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

model EndingType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @db.Text
  guidance    String   @db.Text
  patterns    Json     @default("[]")
  sortOrder   Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
}

model TopicSelection {
  id                 String   @id @default(cuid())
  userId             String
  ipProfileId        String
  elementCodes       Json
  candidates         Json
  selectedIndex      Int?
  promptText         String   @db.Text
  sourceHighlights   Json?
  model              String?
  status             String   @default("pending")
  recommendationMode String?  @db.VarChar(20) // normal | daily | weekly，用于判断"今天的每日推荐"
  recommendedDate    String?  @db.VarChar(10) // YYYY-MM-DD，生成当天日期，便于按天查重
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  ipProfile IpProfile @relation(fields: [ipProfileId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([ipProfileId])
  @@index([userId, recommendationMode, recommendedDate])
}

model ContentTemplate {
  id                  String    @id @default(cuid())
  name                String
  displayName         String
  description         String?   @db.Text
  scriptTemplate      String    @db.Text
  expressionBlueprint Json?
  variables           Json      @default("[]")
  hookType            String?
  industry            Json      @default("[]") // JSON array of strings for MySQL
  contentType         String // product_intro | promotion | knowledge | story | testimonial
  tags                Json      @default("[]") // JSON array of display tags
  hotTopicKeywords    Json      @default("[]") // JSON array for hot topic matching
  seasonalEvents      Json      @default("[]") // JSON array of {id, startDate, endDate}
  status              String    @default("draft") // draft | published | archived
  sortOrder           Int       @default(0)
  featured            Boolean   @default(false)
  usageCount          Int       @default(0)
  createdBy           String
  publishedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([status, sortOrder])
  @@index([featured, status])
}

model Inspiration {
  id        String         @id @default(cuid())
  userId    String
  projectId String?
  user      User           @relation(fields: [userId], references: [id])
  project   ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // 灵感来源：text | feishu | workbuddy_wechat | wecom | webhook
  source           String  @default("text") @db.VarChar(40)
  content          String  @db.Text
  aiStatus         String  @default("pending") @db.VarChar(20)
  processingStage  String? @db.VarChar(32)
  generatedTopics  Json?
  generatedContent Json?
  aimGenerationId  String?
  errorMessage     String? @db.Text

  externalMessageId  String?   @db.VarChar(191)
  externalChatId     String?   @db.VarChar(191)
  externalAccountId  String?   @db.VarChar(191)
  externalSenderId   String?   @db.VarChar(191)
  externalOccurredAt DateTime?
  dedupeKey          String?   @unique @db.VarChar(191)
  sourceUrl          String?   @db.VarChar(800)
  canonicalSourceKey  String?   @unique @db.VarChar(255) // e.g. "douyin:7123456789" for content-level dedup

  videoCopyExtractionId String?
  knowledgeEntryId      String?
  topicSelectionId      String?

  replyStatus       String?   @db.VarChar(24)
  replyAttempts     Int       @default(0)
  replyErrorMessage String?   @db.Text
  replyClaimToken   String?   @unique @db.VarChar(191)
  replyClaimedAt    DateTime?
  repliedAt         DateTime?
  executionModeSnapshot String? @db.VarChar(20) // capture_only | evaluate | live，事件入库时的快照

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, aiStatus])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([source, externalChatId])
  @@index([replyStatus, updatedAt])
  @@index([executionModeSnapshot])
  @@index([source])

  outboxReplies ChannelReplyOutbox[]
}

model ChannelBinding {
  id                String   @id @default(cuid())
  platform          String   @db.VarChar(40)
  externalChatId    String   @db.VarChar(191)
  externalAccountId String   @default("") @db.VarChar(191) // empty string = default, non-empty = multi-account disambiguation
  userId            String
  projectId         String
  triggerMode       String   @default("mention_or_keyword") @db.VarChar(32)
  triggerKeywords   Json     @default("[\"\u6536\u9009\u9898\"]")
  executionMode     String   @default("capture_only") @db.VarChar(20) // capture_only | evaluate | live — 正式灰度从 capture_only 起
  /// Routing target for messages in this chat: "topic" (collect inspiration, default)
  /// or "aim" (invoke an AIM agent conversation). When "aim", defaultAgentId picks
  /// the agent unless the message uses a /command prefix.
  routeTarget       String   @default("topic") @db.VarChar(16)
  /// Default AIM agent for this chat when routeTarget="aim" and no /command is given.
  /// Null means "require a /command" (no implicit default).
  defaultAgentId    String?  @db.VarChar(40)
  status            String   @default("active") @db.VarChar(20)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  project ClientProject @relation(fields: [projectId], references: [id])

  @@unique([platform, externalAccountId, externalChatId])
  @@index([userId, status])
  @@index([projectId, status])
}

/// An AIM agent conversation bound to one external chat + one agent.
/// One chat can have multiple concurrent conversations (one per agentId).
/// Created lazily on the first routed message.
model AimConversation {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  platform        String   @db.VarChar(40)   // feishu | wecom | workbuddy_wechat
  externalChatId  String   @db.VarChar(191)
  agentId         String   @db.VarChar(40)   // content_producer | deep_copywriter | ...
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages AimConversationMessage[]

  @@unique([platform, externalChatId, agentId])
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

/// A single turn in an AIM channel conversation (user message or assistant reply).
model AimConversationMessage {
  id                 String   @id @default(cuid())
  conversationId     String
  role               String   @db.VarChar(16) // user | assistant
  /// For role=user: the incoming message text. For role=assistant: the generated reply.
  content            String   @db.MediumText
  /// Resolved agent that handled this turn (user turns record which agent was targeted).
  agentId            String   @db.VarChar(40)
  /// External message id this turn originated from (user) or replied to (assistant).
  externalMessageId  String?  @db.VarChar(191)
  /// Idempotency key derived from the external message id, prevents duplicate processing.
  dedupeKey          String?  @unique @db.VarChar(191)
  /// Link to the persisted AIM generation (assistant turns only).
  aimGenerationId    String?  @db.VarChar(40)
  /// Short summary shown back to the user when the full result was too long.
  resultSummary      String?  @db.Text
  status             String   @default("completed") @db.VarChar(20) // completed | failed
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  conversation AimConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([agentId, createdAt])
}

/// Outbox table for async platform reply delivery.
/// Decouples reply creation from reply sending, enabling retry, dead-letter handling,
/// and unified delivery across Feishu, WeCom, and WorkBuddy platforms.
model ChannelReplyOutbox {
  id                String    @id @default(cuid())
  inspirationId     String
  replyType         String    @db.VarChar(20)   // accepted | final | already_collected | error
  platform          String    @db.VarChar(40)   // feishu | wecom | workbuddy_wechat
  externalAccountId String?   @db.VarChar(191)
  externalChatId    String    @db.VarChar(191)
  externalMessageId String?   @db.VarChar(191)
  replyText         String    @db.Text
  status            String    @default("pending") @db.VarChar(24)
  // pending → sending → sent
  //                 → retry_wait → dead_letter
  //                 → suppressed
  claimToken        String?   @unique @db.VarChar(191)
  claimExpiresAt    DateTime?
  availableAt       DateTime?  // Earliest time this reply is eligible for (re)delivery
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  lastError         String?   @db.Text
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([platform, status])
  @@index([status, claimExpiresAt])
  @@index([status, availableAt])
  @@unique([inspirationId, replyType])
}
