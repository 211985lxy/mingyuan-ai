// Identity domain models

model User {
  id        String    @id @default(cuid())
  email     String    @unique // 手机号注册用户为 `${phone}@phone.local` 占位
  phone     String?   @unique // 手机号验证码登录通道；存量邮箱用户为空
  password  String
  name      String
  plan      String    @default("free") // free | basic | pro
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 一个 AIM 登录账号只绑定一个 IP/客户项目；项目本身仍可作为知识与生成的隔离边界。
  boundProjectId       String?   @unique
  projectBoundAt       DateTime?
  projectBindingSource String?   @db.VarChar(24)

  ipProfile               IpProfile?
  douyinBindings          DouyinAccountBinding[]
  douyinLoginIdentities   DouyinLoginIdentity[]
  contentGenerationRuns   ContentGenerationRun[]
  assets                  Asset[]
  assetUploadReservations AssetUploadReservation[]
  scripts                 Script[]
  activationCodes         ActivationCode[]
  topicSelections         TopicSelection[]
  competitorAnalyses      CompetitorAnalysis[]
  watchAccounts           WatchAccount[]
  videoCopyExtractions    VideoCopyExtraction[]
  knowledgeEntries        KnowledgeEntry[]
  knowledgeEntities       KnowledgeEntity[]
  aimGenerations          AimGeneration[]
  aimMemories             AimMemory[]
  clientProjects          ClientProject[]          @relation("ProjectOwner")
  boundProject            ClientProject?           @relation("AccountBoundProject", fields: [boundProjectId], references: [id], onDelete: SetNull)
  ipWikiPages             IpWikiPage[]
  benchmarkProfiles       BenchmarkProfile[]
  inspirations            Inspiration[]
  channelBindings         ChannelBinding[]
  agentApiKeys            AgentApiKey[]
  agentApiCallLogs        AgentApiCallLog[]
  agentInvocations        AgentInvocation[]
  aimExecutionTraces      AimExecutionTrace[]
  aimRunSnapshots         AimRunSnapshot[]
  aimRunEvents            AimRunEvent[]
  contentOutcomes         ContentOutcome[]
  outcomeAttributions     OutcomeAttribution[]
  assetCandidates         AssetCandidate[]
  commentInsightJobs      CommentInsightJob[]
  aimContentVersions      AimContentVersion[]
  methodologyProfiles     MethodologyProfile[]
  opportunitySearchRuns   OpportunitySearchRun[]
  opportunityCollections  OpportunityCollection[]
  userQuestionCards       UserQuestionCard[]
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           String   @default("editor") // editor | admin
  isActive       Boolean  @default(true)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activationCodes ActivationCode[]
  auditLogs       AdminAuditLog[]
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(80)
  targetId   String?  @db.VarChar(191)
  requestId  String   @db.VarChar(80)
  correlationId String? @db.VarChar(80)
  status     String   @default("success") @db.VarChar(16)
  severity   String   @default("info") @db.VarChar(16)
  metadata   Json?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([requestId])
  @@index([status, createdAt])
  @@index([correlationId, createdAt])
}

/// Cross-source append-only index used by the administrator audit center.
/// Specialist records remain in their source tables; this table stores only
/// normalized, redacted metadata and correlation links.
model AuditEvent {
  id               String   @id @default(cuid())
  occurredAt       DateTime
  ingestedAt       DateTime @default(now())
  source           String   @db.VarChar(32)
  category         String   @db.VarChar(32)
  severity         String   @db.VarChar(16)
  status           String   @db.VarChar(16)
  action           String   @db.VarChar(120)
  summary          String   @db.Text
  actorType        String?  @db.VarChar(32)
  actorIdHash      String?  @db.VarChar(32)
  targetType       String?  @db.VarChar(80)
  targetId         String?  @db.VarChar(191)
  projectId        String?  @db.VarChar(191)
  environment      String?  @db.VarChar(32)
  correlationId    String?  @db.VarChar(80)
  requestId        String?  @db.VarChar(80)
  traceId          String?  @db.VarChar(80)
  gitSha           String?  @db.VarChar(64)
  sourceRecordType String?  @db.VarChar(80)
  sourceRecordId   String?  @db.VarChar(191)
  idempotencyKey   String   @db.VarChar(191)
  payloadHash      String   @db.VarChar(64)
  metadata         Json?
  externalLogUrl   String?  @db.Text

  @@unique([source, idempotencyKey])
  @@index([occurredAt(sort: Desc)])
  @@index([source, occurredAt(sort: Desc)])
  @@index([category, occurredAt(sort: Desc)])
  @@index([severity, occurredAt(sort: Desc)])
  @@index([status, occurredAt(sort: Desc)])
  @@index([correlationId, occurredAt(sort: Desc)])
  @@index([actorIdHash, occurredAt(sort: Desc)])
  @@index([projectId, occurredAt(sort: Desc)])
}

/// Durable cursor for cross-source audit indexing and historical backfill.
model AuditReconcileCheckpoint {
  id             String   @id @default(cuid())
  source         String   @unique @db.VarChar(32)
  highWatermarkAt DateTime?
  highWatermarkId String?  @db.VarChar(191)
  backfillCursor String?   @db.Text
  lastSuccessAt  DateTime?
  lastError      String?   @db.Text
  scanned        Int      @default(0)
  indexed        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([lastSuccessAt])
  @@index([source, updatedAt])
}

/// Backend alert inbox state. The fingerprint is the deduplication boundary.
model OperationalAlert {
  id              String   @id @default(cuid())
  fingerprint     String   @unique @db.VarChar(191)
  rule            String   @db.VarChar(80)
  severity        String   @db.VarChar(16)
  status          String   @default("open") @db.VarChar(20)
  summary         String   @db.Text
  source          String   @db.VarChar(40)
  correlationId   String?  @db.VarChar(80)
  metadata        Json?
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  occurrenceCount Int      @default(1)
  lastNotifiedAt  DateTime?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?  @db.VarChar(191)
  resolvedAt      DateTime?
  resolvedBy      String?  @db.VarChar(191)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, severity, lastSeenAt])
  @@index([rule, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([correlationId, lastSeenAt])
}

/// Durable low-cardinality daily channel counters used by admin reporting.
model ChannelMetricDaily {
  id        String   @id @default(cuid())
  day       String   @db.VarChar(10) // Shanghai calendar date: YYYY-MM-DD
  platform  String   @db.VarChar(40)
  metric    String   @db.VarChar(64)
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, platform, metric])
  @@index([day, platform])
  @@index([metric, day])
}

model ActivationCode {
  id           String    @id @default(cuid())
  code         String    @unique
  batchId      String
  batchNote    String?
  durationDays Int       @default(365)
  status       String    @default("unused") // unused | used
  usedBy       String?
  usedAt       DateTime?
  createdBy    String
  createdAt    DateTime  @default(now())

  user  User?     @relation(fields: [usedBy], references: [id])
  admin AdminUser @relation(fields: [createdBy], references: [id])

  @@index([batchId])
  @@index([status])
  @@index([code])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string") // string | number | boolean | json
  category    String   @default("general")
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// 抖音开放平台扫码授权绑定：一个 AIM 用户可绑多个抖音号；同一抖音号也可被多个用户绑定
// token 为敏感凭证：仅存数据库，禁止写日志 / API 返回
model DouyinAccountBinding {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  openId  String  @db.VarChar(128)
  unionId String? @db.VarChar(128)
  scope   String  @db.VarChar(500)

  // OAuth 凭证（用于后续免扫码刷新资料）
  accessToken     String   @db.VarChar(512)
  refreshToken    String   @db.VarChar(512)
  accessExpiresAt DateTime

  // 资料快照（最近一次成功拉取）
  profileSnapshot Json?
  lastSyncedAt    DateTime?
  syncStatus      String    @default("ok") @db.VarChar(20) // ok | expired | failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, openId])
  @@index([openId])
}

// 抖音扫码登录身份：一个 openid 只能归属一个 AIM 用户，一个用户可以绑定多个抖音号。
model DouyinLoginIdentity {
  id        String   @id @default(cuid())
  userId    String
  openId    String   @unique @db.VarChar(128)
  unionId   String?  @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 抖音首次扫码后的短期登录挑战；只存 openid，不存 access/refresh token。
model DouyinLoginChallenge {
  id         String    @id @default(cuid())
  stateHash  String    @unique @db.VarChar(64)
  openId     String    @db.VarChar(128)
  unionId    String?   @db.VarChar(128)
  scope      String    @db.VarChar(500)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

// 手机号短信验证码：只存哈希，5 分钟有效，失败 5 次作废，一次性消费
model SmsVerificationCode {
  id         String    @id @default(cuid())
  phone      String    @db.VarChar(20)
  codeHash   String    @db.VarChar(191)
  purpose    String    @default("login") // login
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}
