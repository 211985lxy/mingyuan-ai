generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── MVP Core Tables ──────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String
  plan         String    @default("free") // free | basic | pro
  authVideoUrl String? // 授权视频 OSS URL，录一次可复用
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ipProfile                      IpProfile?
  contentGenerationRuns          ContentGenerationRun[]
  avatars                        Avatar[]
  assets                         Asset[]
  scripts                        Script[]
  videoTasks                     VideoTask[]
  productionPlans                VideoProductionPlan[]
  publicAvatarPreviewPreferences PublicAvatarPreviewPreference[]
  activationCodes                ActivationCode[]
  topicSelections                TopicSelection[]
  competitorAnalyses             CompetitorAnalysis[]
  watchAccounts                  WatchAccount[]
  videoCopyExtractions           VideoCopyExtraction[]
  knowledgeEntries               KnowledgeEntry[]
  knowledgeEntities              KnowledgeEntity[]
  aimGenerations                 AimGeneration[]
  aimMemories                    AimMemory[]
  clientProjects                 ClientProject[]
  ipWikiPages                    IpWikiPage[]
  benchmarkProfiles              BenchmarkProfile[]
  inspirations                   Inspiration[]
  agentApiKeys                   AgentApiKey[]
  agentApiCallLogs               AgentApiCallLog[]
  aimExecutionTraces             AimExecutionTrace[]
  aimRunSnapshots                AimRunSnapshot[]
  aimRunEvents                   AimRunEvent[]
}

model Avatar {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  status               String   @default("uploading") // uploading | cloning | ready | failed
  coverUrl             String?
  sourceVideoUrl       String?
  externalTaskId       String?  @unique
  externalVirtualmanId String?
  externalSpeakerId    String?
  speakerName          String?
  demoTaskId           String?  @unique
  demoVideoUrl         String?
  errorCode            String?
  errorMessage         String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  videoTasks VideoTask[]

  @@index([userId, status])
  @@index([externalTaskId])
}

model Asset {
  id                String   @id @default(cuid())
  userId            String
  sourceAvatarId    String?
  name              String
  assetType         String // image | video | music | voice
  url               String
  size              Int?
  status            String   @default("ready") // ready | processing | failed
  externalTaskId    String?  @unique
  externalSpeakerId String?
  voiceModel        String? // v1 | v2 | v3 | s1 | s3
  demoAudioUrl      String?
  retryCount        Int      @default(0)
  errorCode         String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, assetType])
  @@index([externalTaskId])
  @@index([sourceAvatarId])
  @@index([status])
}

model Script {
  id               String    @id @default(cuid())
  userId           String
  content          String    @db.Text
  sourceTemplateId String?
  generationRunId  String?
  ipProfileId      String?
  structureId      String?
  status           String    @default("draft") // draft | candidate | selected | discarded
  qualityScore     Float?
  qualityMetadata  Json?
  selectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Phase 14: Copywriting Engine ──
  topicSelectionId  String?
  isHotTopicVersion Boolean  @default(false)

  // ── Quality Gate (PRD Module 4) ──
  openingTypeCode String?  // 使用的开头类型代码
  structureCode   String?  // 使用的文案结构代码
  endingTypeCode  String?  // 使用的结尾类型代码
  qualityReport   Json?    // 四维评分详情 { editorial, aiTaste, attraction, logic }
  rewriteCount    Int      @default(0) // 自动重写次数

  user          User                  @relation(fields: [userId], references: [id])
  generationRun ContentGenerationRun? @relation(fields: [generationRunId], references: [id])
  ipProfile     IpProfile?            @relation(fields: [ipProfileId], references: [id])
  structure     VideoStructure?       @relation(fields: [structureId], references: [id])
  videoTasks    VideoTask[]

  @@index([userId])
  @@index([userId, status])
  @@index([generationRunId])
  @@index([ipProfileId])
  @@index([structureId])
  @@index([topicSelectionId])
}

model VideoTask {
  id                  String    @id @default(cuid())
  userId              String
  avatarId            String?
  scriptId            String?
  productionPlanId    String?
  structureId         String?
  packagingTemplateId String?
  status              String    @default("pending") // pending | processing | completed | failed
  deliveryStatus      String    @default("pending") // pending | durable | degraded
  deliveryWarning     String?   @db.Text
  deliveryExpiresAt   DateTime?
  videoType           String    @default("virtualman_broadcast")
  videoUrl            String?
  coverUrl            String?
  scriptContent       String    @db.Text
  avatarName          String
  duration            Int?
  externalTaskId      String?   @unique
  structureSnapshot   Json?
  packagingSnapshot   Json?
  shanjianPayload     Json?
  errorCode           String?
  errorMessage        String?   @db.Text
  marketingAnalysis   Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  // ── 4K Enhancement (Phase 7) ──────────────────────────
  enhancementStatus       String? // none | pending | processing | completed | failed
  enhancementJobId        String?   @unique
  enhanced4kUrl           String?
  enhanced4kCoverUrl      String?
  enhanced4kDuration      Int?
  enhancementErrorCode    String?
  enhancementErrorMessage String?   @db.Text
  enhancementStartedAt    DateTime?
  enhancementCompletedAt  DateTime?

  user              User                    @relation(fields: [userId], references: [id])
  avatar            Avatar?                 @relation(fields: [avatarId], references: [id])
  script            Script?                 @relation(fields: [scriptId], references: [id])
  productionPlan    VideoProductionPlan?    @relation(fields: [productionPlanId], references: [id])
  structure         VideoStructure?         @relation(fields: [structureId], references: [id])
  packagingTemplate VideoPackagingTemplate? @relation(fields: [packagingTemplateId], references: [id])
  @@index([userId, status])
  @@index([userId, deliveryStatus])
  @@index([externalTaskId])
  @@index([status, updatedAt])
  @@index([productionPlanId])
  @@index([enhancementStatus, updatedAt])
}

model PublicAvatarPreviewCache {
  id             String   @id @default(cuid())
  cacheKey       String   @unique
  virtualmanId   String
  speakerId      String
  text           String   @db.Text
  textHash       String
  status         String   @default("processing") // processing | completed | failed
  externalTaskId String?  @unique
  videoUrl       String?
  coverUrl       String?
  duration       Int?
  errorCode      String?
  errorMessage   String?  @db.Text
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preferences PublicAvatarPreviewPreference[]

  @@index([virtualmanId, speakerId])
  @@index([status, updatedAt])
  @@index([lastAccessedAt])
}

model PublicAvatarPreviewPreference {
  id             String   @id @default(cuid())
  userId         String
  virtualmanId   String
  speakerId      String
  text           String   @db.Text
  previewCacheId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                      @relation(fields: [userId], references: [id])
  previewCache PublicAvatarPreviewCache? @relation(fields: [previewCacheId], references: [id])

  @@unique([userId, virtualmanId])
  @@index([previewCacheId])
  @@index([virtualmanId, updatedAt])
}

model IpProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String?
  nickname       String?
  industry       String?
  primaryOffer   String?  @db.Text
  targetAudience String?  @db.Text
  ipTraits       String?  @db.Text
  toneOfVoice    String?
  proofPoints    String?  @db.Text
  callToAction   String?  @db.Text
  promptSnapshot String?  @db.Text
  isComplete     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── v2 IP Profile (Phase 10) ──────────────────────────
  profileVersion       Int?    @default(1)
  surveyIndustry       String?
  surveyTargetCustomer String? @db.Text
  surveyMonetization   Json?
  surveyPersonalTraits String? @db.Text
  surveyContentGoal    String?
  business             Json?
  persona              Json?
  content              Json?

  user                  User                   @relation(fields: [userId], references: [id])
  scripts               Script[]
  contentGenerationRuns ContentGenerationRun[]
  topicSelections      TopicSelection[]

  @@index([isComplete])
  @@index([profileVersion])
}

// ─── 企业知识库 ─────────────────────────────────────────

model KnowledgeEntry {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  category   String // boss_experience | product_usp | customer_pain | project_case | customer_qa
  title      String
  content    String   @db.Text
  tags       Json     @default("[]")
  sourceType String   @default("manual") // manual | voice_transcribe | import
  valueGrade String?  @db.VarChar(2) // 价值分级：S(战略) | A(战术) | B(参考) | C(索引)；null 视为 B
  sortOrder  Int      @default(0)
  status     String   @default("active") // active | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  embedding KnowledgeEmbedding?
  relations KnowledgeRelation[]

  @@index([userId, category])
  @@index([userId, status])
  @@index([userId, valueGrade])
  @@index([projectId])
}

model KnowledgeEmbedding {
  id           String   @id @default(cuid())
  entryId      String   @unique
  embedding    Json
  dimensions   Int      @default(1024)
  model        String
  contentHash  String   @db.VarChar(64)
  status       String   @default("pending") @db.VarChar(20) // pending | completed | failed
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([contentHash])
}

// ─── 知识实体 / 关系（轻量知识图谱） ───────────────────────
// 借鉴 Cognee 的 cognify 管道：把知识条目增量抽取成实体-关系三元组，
// 让「同一概念跨多条知识连通」，作为向量检索的补充召回来源。

model KnowledgeEntity {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  name      String // 实体名（归一化后），如「创始人老王」「美白精华」
  type      String   @db.VarChar(40) // person | product | brand | concept | pain | channel | audience
  aliases   Json     @default("[]") // 别名数组，用于归并
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  relationsFrom KnowledgeRelation[] @relation("RelationFrom")
  relationsTo   KnowledgeRelation[] @relation("RelationTo")

  @@unique([userId, projectId, name, type])
  @@index([projectId, status])
  @@index([userId, name])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  fromEntityId String
  toEntityId   String
  entryId      String // 关系来源于哪条知识（可溯源）
  type         String @db.VarChar(40) // sells | targets | mentions | solves | competes_with | part_of
  weight       Float   @default(1.0)
  evidence     String? @db.Text // 原文片段
  createdAt    DateTime @default(now())

  fromEntity KnowledgeEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   KnowledgeEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  entry      KnowledgeEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, entryId, type])
  @@index([fromEntityId, type])
  @@index([entryId])
}

// ─── AIM 智能体持久化记忆 ─────────────────────────────────
// 把对话中值得长期记住的事实/偏好/决策沉淀下来，下次同项目同 agent 召回。
// 与 /api/aim/evolve（只产出建议不落库）互补。

model AimMemory {
  id                 String   @id @default(cuid())
  userId             String
  projectId          String?
  agentId            String  @db.VarChar(40)
  kind               String  @db.VarChar(24) // conversation_summary | preference | decision | fact
  content            String  @db.Text // 摘要/偏好内容
  entityIds          Json    @default("[]") // 关联到 KnowledgeEntity.id，打通知识图谱
  sourceGenerationId String? // 溯源到 AimGeneration
  relevance          Float   @default(1.0) // 衰减权重（暂未使用，预留）
  status             String  @default("active") // active | archived
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  @@index([userId, projectId, agentId])
  @@index([userId, projectId, kind])
  @@index([projectId, createdAt(sort: Desc)])
}

// ─── 客户项目 / 交付空间 ─────────────────────────────────

model ClientProject {
  id             String   @id @default(cuid())
  userId         String
  name           String
  companyName    String?
  industry       String?
  targetCustomer String?  @db.Text
  offer          String?  @db.Text
  deliveryGoal   String?  @db.Text
  status         String   @default("active") // active | paused | archived
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  aimGenerations   AimGeneration[]
  knowledgeEntries KnowledgeEntry[]
  knowledgeEntities KnowledgeEntity[]
  aimMemories      AimMemory[]
  ipWikiPages      IpWikiPage[]
  benchmarkProfiles BenchmarkProfile[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─── AIM 生成记录 ───────────────────────────────────────

model AimGeneration {
  id               String   @id @default(cuid())
  userId           String
  agentId          String?
  projectId        String?
  rawInput         String   @db.MediumText
  inputSource      String   @default("text") // text | voice
  videoScript      String?  @db.MediumText
  wechatArticle    String?  @db.MediumText
  momentsPost      String?  @db.MediumText
  communityMessage String?  @db.MediumText
  shootingBrief    String?  @db.MediumText
  rawCopy          String?  @db.MediumText
  formatsRequested Json     @default("[]")
  knowledgeUsed    Json     @default("[]")
  ipSnapshotUsed   String?  @db.MediumText
  qualityScores    Json?
  topicTitle       String?  @db.Text
  hotTopic         String?  @db.Text
  polishInstruction String? @db.MediumText
  workflowStatus   String   @default("draft")
  reviewNote       String?  @db.MediumText
  publishedAt      DateTime?
  publishPlatform  String?
  publishUrl       String?  @db.MediumText
  decisionSnapshot Json?
  retroSnapshots   Json     @default("[]")
  calibrationRules Json     @default("[]")
  wechatDraft      Json?
  model            String?
  totalTokens      Int?
  status           String   @default("completed")
  errorMessage     String?  @db.MediumText
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, projectId, createdAt(sort: Desc)])
  @@index([userId, workflowStatus])
}

// ─── IP 定位维基（Karpathy LLM-Wiki 模式） ──────────────
// 每个 IP 营销全案一个「活体维基」：定位策划官产出的定位方案经 LLM
// 增量编译成结构化页（定位主张/人设/内容策略底盘/目标人群/成交路径/选题方向），
// 下游 agent 生成时直接读「已编译」的页，而非每次 JIT 向量检索碎片。

model IpWikiPage {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  pageType    String // positioning | persona | content_strategy | audience | conversion_path | topic_direction | index | log
  title       String
  content     String   @db.Text
  frontmatter Json     @default("{}") // 结构化字段（如内容策略底盘的话题分布/钩子/频率/时段/爆款公式）
  sources     Json     @default("[]") // 溯源：[{ kind: "aim_generation" | "knowledge_entry", id, label }]
  links       Json     @default("[]") // [[双向链接]] 目标 title 列表
  sourceGenerationId String? // 编译自哪条 AimGeneration（定位方案），可溯源指针
  version     Int      @default(1)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id])
  project ClientProject @relation(fields: [projectId], references: [id])

  @@index([projectId, status])
  @@index([projectId, pageType, status])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── 外部 Agent 调用 ─────────────────────────────────────

model AgentApiKey {
  id              String    @id @default(cuid())
  userId          String
  name            String
  keyPrefix       String
  keyHash         String    @unique
  status          String    @default("active") // active | disabled
  allowedProjects Json      @default("[]")
  allowedAgents   Json      @default("[]")
  dailyLimit      Int       @default(50)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  logs AgentApiCallLog[]

  @@index([userId, status])
  @@index([keyPrefix])
}

model AgentApiCallLog {
  id             String   @id @default(cuid())
  apiKeyId       String?
  userId         String?
  projectId      String?
  agentId        String?
  action         String
  inputSummary   String?  @db.Text
  outputFormats  Json     @default("[]")
  status         String   // success | failed
  errorMessage   String?  @db.Text
  durationMs     Int?
  aimGenerationId String?
  createdAt      DateTime @default(now())

  apiKey AgentApiKey? @relation(fields: [apiKeyId], references: [id])
  user   User?        @relation(fields: [userId], references: [id])

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AimExecutionTrace {
  id              String    @id @default(cuid())
  userId          String?
  projectId       String?
  agentId         String?
  action          String
  status          String    @default("running") // running | success | failed
  durationMs      Int?
  model           String?
  totalTokens     Int?
  inputSummary    String?   @db.Text
  outputSummary   String?   @db.Text
  errorMessage    String?   @db.Text
  steps           Json      @default("[]")
  aimGenerationId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── aim-harness-v1 长期可观测字段（不随快照过期，长期保留） ──
  runId             String?  @db.VarChar(40) // 对外执行编号，= AimRunSnapshot.runId
  provider          String?  @db.VarChar(64) // 实际命中的 provider（与 model 分别记录）
  fallbackIndex     Int?     // 命中第几个 provider（0=首选）
  degraded          Boolean? // fallback 后继续交付则 true
  harnessVersion    String?  @db.VarChar(40) // "aim-harness-v1"
  runtimeTask       String?  @db.VarChar(32)
  conversationMode  String?  @db.VarChar(32)
  knowledgeStrategy String?  @db.VarChar(32)
  promptHash        String?  @db.VarChar(64) // 最终组合 prompt 的 SHA-256
  contextHash       String?  @db.VarChar(64) // 上下文清单的 SHA-256
  qualityStatus     String?  @db.VarChar(24) // 主稿质量结果：pass | warn | fail | skipped
  snapshotId        String?  @db.VarChar(40) // 关联完整快照（可能已过期删除）

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([runId])
  @@index([promptHash])
  @@index([qualityStatus])
}

// AIM Thin Harness v1 完整运行快照：保存 runSpec、上下文清单、provider 尝试、
// 完整文本 prompt、输出、质量结果、哈希与 expiresAt。仅管理员可见，30 天由
// cron/cleanup 删除；关联的 trace 元数据（provider/model/哈希/指标）长期保留。
// 图片只保存哈希和类型，不保存 base64 或临时签名地址。
model AimRunSnapshot {
  id              String   @id @default(cuid())
  runId           String   @unique @db.VarChar(40) // 对外稳定执行编号（= trace.runId）
  traceId         String?  @db.VarChar(40)         // 关联 AimExecutionTrace.id
  userId          String?
  projectId       String?
  agentId         String?
  action          String?  @db.VarChar(32)         // chat | generate | agent_api | inspiration | tool_action

  runSpec          Json     @default("{}")  // AimRunSpec 快照
  contextManifest  Json     @default("[]")  // 上下文来源清单（id/更新时间/字符数/SHA-256）
  providerAttempts Json     @default("[]")  // 每次 provider 尝试（provider/model/状态/错误/耗时）
  fullPrompt       String?  @db.MediumText  // 完整文本 prompt（管理员可见）
  promptMessages   Json     @default("[]")  // 结构化 role/content；图片仅保存 hash
  promptHash       String?  @db.VarChar(64)
  contextHash      String?  @db.VarChar(64)
  output           String?  @db.MediumText  // 原样生成稿
  outputFormats    Json     @default("[]")  // ContentFormat[]
  qualityResult    Json?                   // 主稿 LLM 评分 + 全部格式确定性检查
  imageHashes      Json     @default("[]")  // [{hash, type}]，不存 base64/签名地址

  provider      String?  @db.VarChar(64)
  model         String?  @db.VarChar(64)
  fallbackIndex Int?
  degraded      Boolean?

  expiresAt DateTime // 30 天后由 cron/cleanup 删除
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([traceId])
}

model AimRunEvent {
  id        String   @id @default(cuid())
  runId     String   @db.VarChar(40)
  userId    String
  event     String   @db.VarChar(24) // copied | revised | accepted
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([runId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
}

model ContentGenerationRun {
  id                String   @id @default(cuid())
  userId            String
  ipProfileId       String
  templateId        String
  structureId       String?
  structureSnapshot Json?
  hotTopicId        String?
  hotTopic          String?
  hotTopicInsight   Json?
  hotTopicFit       Json?
  inputsJson        Json
  promptText        String   @db.Text
  model             String
  status            String    @default("succeeded") // pending | succeeded | failed | degraded
  qualityScore      Float?
  qualityMetadata   Json?
  errorMessage      String?  @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ── Phase 14: Copywriting Engine (Topic Selection context) ──
  topicSelectionId  String?
  openingTypeCode   String?
  copyStructureCode String?
  endingTypeCode    String?

  user      User            @relation(fields: [userId], references: [id])
  ipProfile IpProfile       @relation(fields: [ipProfileId], references: [id])
  structure VideoStructure? @relation(fields: [structureId], references: [id])
  scripts   Script[]

  @@index([userId, createdAt])
  @@index([templateId])
  @@index([structureId])
  @@index([hotTopicId])
  @@index([topicSelectionId])
}

model HotTopicFitCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  topicId     String
  topicTitle  String
  templateId  String
  structureId String
  ipProfileId String
  fitJson     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topicId, templateId, structureId])
  @@index([ipProfileId, updatedAt])
}

// ─── Three-Layer Video Creation ──────────────────────────

model VideoStructure {
