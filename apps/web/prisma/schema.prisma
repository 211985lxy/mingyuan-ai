// ─── System Settings ─────────────────────────────────────

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  type        String   @default("string") // string | number | boolean | json
  category    String   @default("general")
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─── Pexels Media Library ───────────────────────────────

model PexelsMedia {
  id                String    @id @default(cuid())
  provider          String    @default("pexels") // pexels | pixabay
  pexelsId          Int // external ID from provider
  mediaType         String // photo | video
  width             Int
  height            Int
  url               String // source webpage URL
  photographer      String
  photographerUrl   String?
  photographerId    BigInt?
  avgColor          String?
  alt               String?   @db.Text
  duration          Int? // Video duration in seconds, null for photos
  srcJson           Json? // Photo src object (size variants)
  videoFilesJson    Json? // Video files array
  videoPicturesJson Json? // Video preview pictures array
  imageUrl          String? // Video cover image URL
  ossUrl            String? // Our durable OSS copy
  ossStatus         String    @default("pending") // pending | transferring | ready | failed
  ossTransferredAt  DateTime?
  discoveryQuery    String? // First search query that found this media
  createdAt         DateTime  @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, pexelsId])
  @@index([mediaType, createdAt])
  @@index([ossStatus])
  @@index([discoveryQuery])
  @@index([provider])
}

model PexelsQueryCache {
  id            String   @id @default(cuid())
  provider      String   @default("pexels") // pexels | pixabay
  queryHash     String   @unique // SHA-256 of normalized query params (includes provider + schemaVersion)
  query         String
  mediaType     String // photo | video | all
  orientation   String?
  size          String?
  color         String?
  schemaVersion Int      @default(1) // Cache schema version; increment to invalidate pre-scoring entries
  totalResults  Int      @default(0)
  pexelsIds     Json // number[] ordered by relevance
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([query, mediaType])
  @@index([provider])
}

// ─── Competitor Analysis (v5.0) ───────────────────────────

model CompetitorAnalysis {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  // Input
  targetUrl         String   @db.VarChar(500)
  platform          String   @db.VarChar(20)   // douyin | xiaohongshu | bilibili | kuaishou
  platformUserId    String?  @db.VarChar(200)  // sec_user_id / user_id / uid

  // Pipeline status
  status            String   @default("pending") @db.VarChar(20)
  // pending → scraping → enriching → analyzing → completed → failed
  currentStep       String?  @db.VarChar(20)
  errorMessage      String?  @db.Text

  // Raw data (JSON)
  rawAccountData    Json?    // Platform-returned account info
  rawVideoData      Json?    // Video list + stats
  rawCommentData    Json?    // Comment samples

  // Collection source
  collectionSource  String?  @db.VarChar(40) // external_api | redfox_api | local_browser | tikhub_api
  fallbackUsed      Boolean  @default(false)
  fallbackReason    String?  @db.Text

  // Computed metrics
  metricsData       Json?    // Quantitative metrics (engagement rate, posting frequency, etc.)

  // AI analysis result
  analysisResult    Json?    // Full report JSON (6-dimension scores + narrative)
  overallScore      Int?     // Overall score 0-100

  // Cached display data
  accountName       String?  @db.VarChar(100)
  accountAvatar     String?  @db.VarChar(500)
  followerCount     Int?
  videoCount        Int?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedAt       DateTime?

  // Cost tracking
  apiCostUsd        Float?   @default(0)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, platform])
}

// ─── Watch Accounts (对标账号监控看板) ──────────────────────

model WatchAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])

  // Input
  targetUrl         String    @db.VarChar(500)
  platform          String    @default("douyin") @db.VarChar(20)

  // Cached account info (from refresh)
  platformUserId    String?   @db.VarChar(200)
  nickname          String?   @db.VarChar(100)
  avatar            String?   @db.VarChar(500)
  followerCount     Int?

  // Cached video data (from refresh)
  latestVideos      Json?     // NormalizedVideo[] — newest works
  viralVideos       Json?     // NormalizedVideo[] — viral picks by engagement

  // Refresh tracking
  refreshStatus     String    @default("idle") @db.VarChar(20)
  // idle | refreshing | success | failed
  refreshError      String?   @db.Text
  lastRefreshedAt   DateTime?

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, targetUrl])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── Video Copy Extraction（视频文案提取分析） ───────────────

model VideoCopyExtraction {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])

  sourceUrl       String    @db.VarChar(800)
  platform        String    @default("unknown") @db.VarChar(40)
  status          String    @default("queued") @db.VarChar(20)
  errorMessage    String?   @db.Text
  analysisError   String?   @db.Text

  providerBatchId String?   @db.VarChar(120)
  providerTaskId  String?   @db.VarChar(120)

  videoTitle      String?   @db.VarChar(500)
  videoCover      String?   @db.VarChar(800)
  videoDuration   String?   @db.VarChar(40)
  transcript      String?   @db.LongText
  analysisResult  Json?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
}

// ─── Inspiration（灵感收集） ──────────────────────────────────

model Inspiration {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  // 灵感来源：text(手写/粘贴) | feishu_webhook | wechat
  source         String    @default("text") @db.VarChar(40)
  // 灵感内容
  content        String    @db.Text
  // AI 状态：pending | processing | completed | failed
  aiStatus       String    @default("pending") @db.VarChar(20)
  // AI 生成的选题 (JSON array of topic card)
  generatedTopics Json?
  // AI 生成的文案内容 (AimGenerateResponse)
  generatedContent Json?
  // 关联的 AIM 生成记录 id
  aimGenerationId String?
  // 错误信息
  errorMessage   String?   @db.Text

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, aiStatus])
  @@index([source])
}

// ─── Benchmark Profile（对标账号整体档案） ──────────────────────
// 一个对标账号 = 一套长期参照档案：结构化头部（账号画像）+ 可挂多条自由素材。
// 绑定到 IP 营销全案（projectId），档案素材同步落一条 KnowledgeEntry
// （category=benchmark_reference），自动进入现有 RAG 检索被选题/AIM 复用。

model BenchmarkProfile {
  id          String   @id @default(cuid())
  userId      String
  projectId   String

  // ── 结构化头部：账号画像 ──
  name           String                     // 账号名称
  platform       String   @db.VarChar(20)   // douyin | xiaohongshu | bilibili | kuaishou
  accountUrl     String?  @db.VarChar(500)  // 主页链接（稳定锚点，一键拉取匹配用）
  platformUserId String?  @db.VarChar(200)  // sec_user_id / user_id / uid
  followerCount  Int?
  personaTags    Json     @default("[]")    // 人设标签数组
  positioning    String?  @db.Text          // 内容定位
  differentiator String?  @db.Text          // 差异化
  takeaways      String?  @db.Text          // 借鉴要点（迁移给本 IP 时怎么用）

  // ── 一键拉取来源快照（可选） ──
  competitorAnalysisId String? @db.VarChar(40)

  // ── 元数据 ──
  status    String   @default("active") @db.VarChar(20) // active | archived
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                 @relation(fields: [userId], references: [id])
  project ClientProject        @relation(fields: [projectId], references: [id])
  items   BenchmarkProfileItem[]

  @@index([userId, status])
  @@index([projectId])
  @@index([userId, accountUrl])
}

model BenchmarkProfileItem {
  id        String   @id @default(cuid())
  profileId String
  kind      String   @db.VarChar(20) // note | report | copy_extraction | video
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile BenchmarkProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ─── Agent Methodology（智能体方法论库，可在后台编辑） ──
// 对应 mingyuan/docs/*-methodology-core.md 三份方法论。
// 加载器优先读 DB，无则回退文件并播种。编辑后通过版本号使内存缓存失效。
model AgentMethodology {
  id        String   @id @default(cuid())
  key       String   @unique // ip_copywriting | business_diagnosis | event_storytelling
  title     String
  content   String   @db.Text // markdown 全文
  filePath  String?  // 对应的 md 文件相对路径，仅记录溯源
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
