}

model TopicSelection {
  id                String    @id @default(cuid())
  userId            String
  ipProfileId       String
  elementCodes      Json
  candidates        Json
  selectedIndex     Int?
  promptText        String    @db.Text
  sourceHighlights  Json?
  model             String?
  status            String    @default("pending")
  recommendationMode String?  @db.VarChar(20) // normal | daily | weekly，用于判断"今天的每日推荐"
