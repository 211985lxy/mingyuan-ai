// ─── Content Templates ────────────────────────────────────

model ContentTemplate {
  id                  String    @id @default(cuid())
  name                String
  displayName         String
  description         String?   @db.Text
  scriptTemplate      String    @db.Text
  expressionBlueprint Json?
  variables           Json      @default("[]")
