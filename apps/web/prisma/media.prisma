// Media domain models

model Avatar {
  id                   String   @id @default(cuid())
  userId               String
  projectId            String?
  name                 String
  status               String   @default("uploading") // uploading | cloning | ready | failed
  provider             String   @default("chanjing") // chanjing | shanjian
  authorizationText    String?  @db.Text
  authorizationConfirmedAt DateTime?
  coverUrl             String?
  sourceVideoUrl       String?
  externalTaskId       String?  @unique
  externalVirtualmanId String?
  externalSpeakerId    String?
  speakerName          String?
  demoTaskId           String?  @unique
  demoVideoUrl         String?
  errorCode            String?
  errorMessage         String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  project    ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  videoTasks VideoTask[]

  @@index([userId, status])
  @@index([userId, projectId, status])
  @@index([provider, externalTaskId])
  @@index([externalTaskId])
}

model Asset {
  id                String   @id @default(cuid())
  userId            String
  sourceAvatarId    String?
  name              String
  assetType         String // image | video | music | voice
  url               String
  size              Int?
  status            String   @default("ready") // ready | processing | failed
  externalTaskId    String?  @unique
  externalSpeakerId String?
  voiceModel        String? // v1 | v2 | v3 | s1 | s3
  demoAudioUrl      String?
  retryCount        Int      @default(0)
  errorCode         String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, assetType])
  @@index([userId, createdAt(sort: Desc)])
  @@index([externalTaskId])
  @@index([sourceAvatarId])
  @@index([status])
}

/// OSS 直传预约：绑定 key / 精确字节数 / Content-Type，避免无界 PUT 预签名
model AssetUploadReservation {
  id                String    @id @default(cuid()) // = uploadId
  userId            String
  objectKey         String
  declaredSizeBytes Int
  contentType       String
  assetType         String // image|document|audio|video
  status            String // pending|completed|expired|aborted
  assetUrl          String
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@index([objectKey])
}

