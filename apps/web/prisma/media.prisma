// Media domain models

model Avatar {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  status               String   @default("uploading") // uploading | cloning | ready | failed
  coverUrl             String?
  sourceVideoUrl       String?
  externalTaskId       String?  @unique
  externalVirtualmanId String?
  externalSpeakerId    String?
  speakerName          String?
  demoTaskId           String?  @unique
  demoVideoUrl         String?
  errorCode            String?
  errorMessage         String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  videoTasks VideoTask[]

  @@index([userId, status])
  @@index([externalTaskId])
}

model Asset {
  id                String   @id @default(cuid())
  userId            String
  sourceAvatarId    String?
  name              String
  assetType         String // image | video | music | voice
  url               String
  size              Int?
  status            String   @default("ready") // ready | processing | failed
  externalTaskId    String?  @unique
  externalSpeakerId String?
  voiceModel        String? // v1 | v2 | v3 | s1 | s3
  demoAudioUrl      String?
  retryCount        Int      @default(0)
  errorCode         String?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, assetType])
  @@index([userId, createdAt(sort: Desc)])
  @@index([externalTaskId])
  @@index([sourceAvatarId])
  @@index([status])
}

/// OSS 直传预约：绑定 key / 精确字节数 / Content-Type，避免无界 PUT 预签名
model AssetUploadReservation {
  id                String    @id @default(cuid()) // = uploadId
  userId            String
  objectKey         String
  declaredSizeBytes Int
  contentType       String
  assetType         String // image|document|audio|video
  status            String // pending|completed|expired|aborted
  assetUrl          String
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@index([objectKey])
}

model PublicAvatarPreviewCache {
  id             String   @id @default(cuid())
  cacheKey       String   @unique
  virtualmanId   String
  speakerId      String
  text           String   @db.Text
  textHash       String
  status         String   @default("processing") // processing | completed | failed
  externalTaskId String?  @unique
  videoUrl       String?
  coverUrl       String?
  duration       Int?
  errorCode      String?
  errorMessage   String?  @db.Text
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  preferences PublicAvatarPreviewPreference[]

  @@index([virtualmanId, speakerId])
  @@index([status, updatedAt])
  @@index([lastAccessedAt])
}

model PublicAvatarPreviewPreference {
  id             String   @id @default(cuid())
  userId         String
  virtualmanId   String
  speakerId      String
  text           String   @db.Text
  previewCacheId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                      @relation(fields: [userId], references: [id])
  previewCache PublicAvatarPreviewCache? @relation(fields: [previewCacheId], references: [id])

  @@unique([userId, virtualmanId])
  @@index([previewCacheId])
  @@index([virtualmanId, updatedAt])
}
