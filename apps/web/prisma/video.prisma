// Video domain models

model VideoTask {
  id                  String    @id @default(cuid())
  userId              String
  projectId           String?
  aimGenerationId     String?
  avatarId            String?
  scriptId            String?
  productionPlanId    String?
  structureId         String?
  packagingTemplateId String?
  status              String    @default("pending") // queued | pending | processing | completed | failed
  provider            String    @default("chanjing") // chanjing | shanjian
  idempotencyKey      String?   @unique
  retryOfTaskId       String?
  providerAttempts    Json?
  deliveryStatus      String    @default("pending") // pending | durable | degraded
  deliveryWarning     String?   @db.Text
  deliveryExpiresAt   DateTime?
  videoType           String    @default("virtualman_broadcast")
  videoUrl            String?
  coverUrl            String?
  scriptContent       String    @db.Text
  avatarName          String
  duration            Int?
  externalTaskId      String?   @unique
  structureSnapshot   Json?
  packagingSnapshot   Json?
  shanjianPayload     Json?
  errorCode           String?
  errorMessage        String?   @db.Text
  marketingAnalysis   Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  // ── 4K Enhancement (Phase 7) ──────────────────────────
  enhancementStatus       String? // none | pending | processing | completed | failed
  enhancementJobId        String?   @unique
  enhanced4kUrl           String?
  enhanced4kCoverUrl      String?
  enhanced4kDuration      Int?
  enhancementErrorCode    String?
  enhancementErrorMessage String?   @db.Text
  enhancementStartedAt    DateTime?
  enhancementCompletedAt  DateTime?

  user              User                    @relation(fields: [userId], references: [id])
  project           ClientProject?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  aimGeneration     AimGeneration?         @relation(fields: [aimGenerationId], references: [id], onDelete: SetNull)
  avatar            Avatar?                 @relation(fields: [avatarId], references: [id])
  script            Script?                 @relation(fields: [scriptId], references: [id])
  productionPlan    VideoProductionPlan?    @relation(fields: [productionPlanId], references: [id])
  structure         VideoStructure?         @relation(fields: [structureId], references: [id])
  packagingTemplate VideoPackagingTemplate? @relation(fields: [packagingTemplateId], references: [id])

  @@index([userId, status])
  @@index([userId, projectId, status])
  @@index([provider, externalTaskId])
  @@index([retryOfTaskId])
  @@index([userId, deliveryStatus])
  @@index([externalTaskId])
  @@index([status, updatedAt])
  @@index([productionPlanId])
  @@index([enhancementStatus, updatedAt])
}

model VideoPackagingTemplate {
  id           String   @id @default(cuid())
  shanjianId   String   @unique
  name         String
  coverUrl     String?
  demoUrl      String?
  scene        String // virtualman | realMan | oralMixCutting | newsMixCutting
  capabilities Json     @default("[]") // Labels: ["subtitle","identity_card","evidence_insert","pip","keyword_highlight"]
  description  String?  @db.Text
  sortOrder    Int      @default(0)
  status       String   @default("published") // published | hidden
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  videoTasks      VideoTask[]
  productionPlans VideoProductionPlan[]

  @@index([scene, status])
  @@index([status, sortOrder])
}

model VideoProductionPlan {
  id                    String   @id @default(cuid())
  userId                String
  scriptId              String
  packagingTemplateId   String?
  structureId           String?
  styleId               String
  materials             Json? // [{role, fileUrl, type}]
  backgroundMusic       Json? // {audioUrl, volume}
  packRules             Json?
  processRules          Json?
  recommendationContext Json?
  videoType             String   @default("virtualman_broadcast")
  status                String   @default("draft") // draft | confirmed(reserved) | used
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user              User                    @relation(fields: [userId], references: [id])
  structure         VideoStructure?         @relation(fields: [structureId], references: [id])
  packagingTemplate VideoPackagingTemplate? @relation(fields: [packagingTemplateId], references: [id])
  videoTasks        VideoTask[]

  @@index([userId, status])
  @@index([scriptId])
}
