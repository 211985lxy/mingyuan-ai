// Operating-system projections (WP-3 / WP-4)
// ContentOutcome remains the content-window snapshot; these models hold per-event business facts.

/** 逐笔经营归因（WP-3）：内容 → 线索/预约/成交/回款；不建 CRM 实体 */
model OutcomeAttribution {
  id                    String   @id @default(cuid())
  userId                String
  generationId          String
  externalLeadId        String   @db.VarChar(80)
  externalAppointmentId String?  @db.VarChar(80)
  externalDealId        String?  @db.VarChar(80)
  externalPaymentId     String?  @db.VarChar(80)
  /** explicit | first_touch | unknown */
  attributionMethod     String   @db.VarChar(20)
  /** high | medium | low */
  attributionConfidence String   @db.VarChar(10)
  occurredAt            DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  generation AimGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([externalLeadId])
  @@unique([externalDealId])
  @@unique([externalPaymentId])
  @@index([userId, occurredAt])
  @@index([generationId])
  @@index([attributionMethod])
}

/**
 * 客户结果投影（WP-4）：正本在飞书，AIM 只存查询投影。
 * 无 baseline/actual/证据/审核人不得标记交付成功；已审核后才可出成功案例候选。
 */
model CustomerOutcomeProjection {
  id                String    @id @default(cuid())
  projectId         String
  externalOutcomeId String    @db.VarChar(80)
  externalDealId    String?   @db.VarChar(80)
  metricCode        String    @db.VarChar(80)
  baseline          Decimal?  @db.Decimal(14, 2)
  target            Decimal?  @db.Decimal(14, 2)
  actual            Decimal?  @db.Decimal(14, 2)
  unit              String?   @db.VarChar(40)
  observedFrom      DateTime
  observedTo        DateTime
  evidenceRef       String    @db.VarChar(500)
  /** pending | approved | rejected */
  reviewStatus      String    @db.VarChar(20)
  reviewerRef       String?   @db.VarChar(120)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([externalOutcomeId])
  @@index([projectId, reviewStatus])
  @@index([externalDealId])
  @@index([metricCode])
}

/** 周度经营复盘周期（WP-5） */
model ReviewCycle {
  id              String    @id @default(cuid())
  periodStart     DateTime
  periodEnd       DateTime
  status          String    @default("draft") @db.VarChar(20) // draft | signed
  metricsSnapshot Json
  systemOwnerId   String    @db.VarChar(191)
  /** 筛选维度快照：projectId / workflowId / ownerId / channel */
  filterSnapshot  Json?
  signedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  actions ReviewAction[]

  @@index([periodStart, periodEnd])
  @@index([status])
  @@index([systemOwnerId])
}

/** 周复盘行动项台账（WP-5） */
model ReviewAction {
  id            String    @id @default(cuid())
  reviewCycleId String
  title         String    @db.VarChar(200)
  ownerId       String    @db.VarChar(191)
  dueAt         DateTime
  status        String    @default("open") @db.VarChar(20) // open | done | cancelled
  evidenceRef   String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviewCycle ReviewCycle @relation(fields: [reviewCycleId], references: [id], onDelete: Cascade)

  @@index([reviewCycleId, status])
  @@index([ownerId, status])
  @@index([dueAt])
}

