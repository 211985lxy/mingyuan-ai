// Knowledge domain models

// 会后资产候选（90 天计划 3.1）：会议洞察人工审核通过后生成，
// 默认 pending 且不允许跨项目复用；人工批准后才可升级为正式知识。
model AssetCandidate {
  id                          String    @id @default(cuid())
  userId                      String
  projectId                   String
  generationId                String // 来源会议洞察 AimGeneration.id（不建外键，资产可独立于生成记录存续）
  feishuRecordId              String?   @db.VarChar(64) // 来源飞书记录
  kind                        String    @db.VarChar(40) // pain_point | customer_quote | objection | deal_trigger | follow_up_script | content_topic | case_candidate | methodology_revision | wiki_patch
  title                       String    @db.VarChar(200)
  content                     String    @db.Text
  evidence                    String?   @db.Text // 原文证据，缺省为 null，不伪造
  confidence                  String    @default("medium") @db.VarChar(10) // high | medium | low
  reviewStatus                String    @default("pending") @db.VarChar(20) // pending | approved | rejected
  crossProjectAllowed         Boolean   @default(false) // 跨项目复用需人工批准
  promotedEntryId             String? // 升级后的 KnowledgeEntry.id
  /**
   * 首次晋升写入；历史缺失保持 null，不回填推测
   */
  promotedAt                  DateTime?
  customerOutcomeProjectionId String?   @unique
  /**
   * wiki_patch 专用：目标 IP 维基页类型（positioning/audience/topic_direction/...）。非 wiki_patch 为 null。
   */
  wikiPageType                String?   @db.VarChar(32)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user                      User                       @relation(fields: [userId], references: [id])
  project                   ClientProject              @relation(fields: [projectId], references: [id])
  customerOutcomeProjection CustomerOutcomeProjection? @relation(fields: [customerOutcomeProjectionId], references: [id], onDelete: SetNull)

  @@index([userId, reviewStatus])
  @@index([userId, projectId, kind])
  @@index([generationId])
  @@index([promotedAt])
}

model KnowledgeEntry {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  category   String // boss_experience | product_usp | customer_pain | project_case | customer_qa
  title      String
  content    String   @db.Text
  tags       Json     @default("[]")
  sourceType String   @default("manual") // manual | voice_transcribe | import
  valueGrade String?  @db.VarChar(2) // 价值分级：S(战略) | A(战术) | B(参考) | C(索引)；null 视为 B
  sortOrder  Int      @default(0)
  status     String   @default("active") // active | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  embedding KnowledgeEmbedding?
  relations KnowledgeRelation[]
  chunks    KnowledgeChunk[]

  @@index([userId, category])
  @@index([userId, status])
  @@index([userId, status, projectId, sortOrder, createdAt(sort: Desc)])
  @@index([userId, valueGrade])
  @@index([projectId])
}

model KnowledgeEmbedding {
  id           String   @id @default(cuid())
  entryId      String   @unique
  embedding    Json
  dimensions   Int      @default(1024)
  model        String
  contentHash  String   @db.VarChar(64)
  status       String   @default("pending") @db.VarChar(20) // pending | completed | failed
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([contentHash])
}

model KnowledgeEntity {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  name      String // 实体名（归一化后），如「创始人老王」「美白精华」
  type      String   @db.VarChar(40) // person | product | brand | concept | pain | channel | audience
  aliases   Json     @default("[]") // 别名数组，用于归并
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  relationsFrom KnowledgeRelation[] @relation("RelationFrom")
  relationsTo   KnowledgeRelation[] @relation("RelationTo")

  @@unique([userId, projectId, name, type])
  @@index([projectId, status])
  @@index([userId, name])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  fromEntityId String
  toEntityId   String
  entryId      String // 关系来源于哪条知识（可溯源）
  type         String   @db.VarChar(40) // sells | targets | mentions | solves | competes_with | part_of
  weight       Float    @default(1.0)
  evidence     String?  @db.Text // 原文片段
  createdAt    DateTime @default(now())

  fromEntity KnowledgeEntity @relation("RelationFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   KnowledgeEntity @relation("RelationTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  entry      KnowledgeEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([fromEntityId, toEntityId, entryId, type])
  @@index([fromEntityId, type])
  @@index([entryId])
}

// 知识块索引（P0）：把检索单元从条目下沉到 ~400 字的带重叠块。
// 存在的原因见 src/lib/llm/chunking.ts 顶部注释 —— 导入切 5000 字、
// 嵌入只取前 500 字，导致长条目约 90% 的内容无法被检索到。
//
// embedding 为 Float32Array 原始字节（1024 维 = 4KB），
// 由 knowledge-chunk-index.ts 的 encodeVector / decodeVector 负责编解码。
//
// @@fulltext([text]) 不是可选声明：P1 的 FULLTEXT 索引由原始 SQL 建立
// （Prisma 语法表达不了 WITH PARSER ngram），schema 里不声明它，
// 下一次 `migrate dev` 会把它判为「库中多余」并生成 DROP INDEX，
// 中文检索静默失效。理由详见 P1 的 knowledge.prisma.patch.md。
model KnowledgeChunk {
  id           String   @id @default(cuid())
  entryId      String
  idx          Int
  text         String   @db.Text
  embedding    Bytes?
  dimensions   Int      @default(1024)
  model        String   @default("BAAI/bge-large-zh-v1.5")
  contentHash  String   @db.VarChar(64)
  status       String   @default("pending") @db.VarChar(20) // pending | completed | failed
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entry KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, idx])
  @@index([entryId])
  @@index([status])
  @@index([contentHash])
  @@fulltext([text])
}
