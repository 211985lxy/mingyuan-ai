// Content Opportunity domain models

model OpportunitySearchRun {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  keyword        String   @db.VarChar(200)
  searchType     String   @default("video") @db.VarChar(20) // video | topic | account
  platforms      Json     @default("[]") // ["douyin","wechat_channels"]
  filters        Json     @default("{}")
  status         String   @default("running") @db.VarChar(20) // running | completed | partial | failed
  platformStatus Json     @default("{}") // {douyin:"ok",wechat_channels:"timeout"}
  resultCount    Int      @default(0)
  apiCostUsd     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id])
  project ClientProject?           @relation(fields: [projectId], references: [id])
  items   OpportunityItemSnapshot[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model OpportunityItemSnapshot {
  id               String    @id @default(cuid())
  searchRunId      String
  platform         String    @db.VarChar(20)
  sourceId         String    @db.VarChar(200)
  sourceUrl        String    @db.VarChar(800)
  title            String    @db.VarChar(500)
  authorName       String    @db.VarChar(100)
  authorId         String?   @db.VarChar(200)
  followerCount    Int?
  publishedAt      DateTime?
  durationSec      Int?
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  collects         Int?
  opportunityScore Float?
  scoreConfidence  String    @default("medium") @db.VarChar(10) // high | medium | low
  scoreBreakdown   Json?
  matchedKeywords  Json      @default("[]")
  fetchedAt        DateTime  @default(now())

  searchRun OpportunitySearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)

  @@unique([searchRunId, platform, sourceId])
  @@index([searchRunId, opportunityScore(sort: Desc)])
}

model OpportunityCollection {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  searchRunId      String?
  name             String?  @db.VarChar(200)
  itemIds          Json     @default("[]") // OpportunityItemSnapshot.id[]
  items            Json     @default("[]") // snapshot redundancy
  status           String   @default("draft") @db.VarChar(20) // draft | analyzing | analyzed | failed
  analysisResult   Json?
  analysisError    String?  @db.Text
  backgroundTaskId String?  @db.VarChar(191)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  project ClientProject? @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}
