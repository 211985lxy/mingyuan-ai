# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/mingyuan"

# Redis
REDIS_URL="redis://localhost:6379"

# Cron Jobs
CRON_SECRET=""
# Set to true in production only after an authenticated background-task scheduler is deployed.
BACKGROUND_TASKS_ENABLED="false"

# Douyin Hot List
DOUYIN_HOT_PRIMARY_URL="https://v2.xxapi.cn/api/douyinhot"
DOUYIN_HOT_FALLBACK_URL="https://api.vvhan.com/api/hotlist/douyinHot"

# Douyin Open Platform (网站应用 OAuth + 事件订阅 Webhook)
# OAuth 授权回调地址，需与抖音开发者后台「回调域名」一致：
DOUYIN_REDIRECT_URI="https://mingyuan-ai.cn/api/integrations/douyin/callback"
DOUYIN_LOGIN_REDIRECT_URI="https://mingyuan-ai.cn/api/auth/douyin/callback"
DOUYIN_CLIENT_KEY=""
DOUYIN_CLIENT_SECRET=""
DOUYIN_DEFAULT_SCOPE="user_info,video.list,fans.basic,fans.profile"
# 事件订阅 Webhook 开关；设为 false 可在不停机时拒绝抖音回调（返回 503）。
# Webhook 地址：https://mingyuan-ai.cn/api/integrations/douyin/events
DOUYIN_EVENT_WEBHOOK_ENABLED="true"

# Admin Bootstrap
ADMIN_EMAIL="admin@mingyuan.com"
ADMIN_PASSWORD=""

# Auth
JWT_SECRET=""
ADMIN_JWT_SECRET=""
OBSIDIAN_SYNC_TOKEN=""
OBSIDIAN_SYNC_USER_ID=""
OBSIDIAN_EXPORT_ENABLED=""
INSPIRATION_WEBHOOK_USER_ID=""

# Optional: OfficeCLI for richer .docx/.pptx/.xlsx text extraction on knowledge import.
# Falls back to MarkItDown / mammoth when unset or unavailable. See https://github.com/iOfficeAI/OfficeCLI
OFFICECLI_BIN="officecli"

# OSS (Aliyun)
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
# Optional: knowledge upload temp dir + document parse timeout (ms)
KNOWLEDGE_UPLOAD_TEMP_DIR=""
DOCUMENT_PARSE_TIMEOUT_MS=""

# AI — TheRouter (primary LLM gateway)
THEROUTER_API_KEY=""
THEROUTER_BASE_URL="https://api.therouter.ai/v1"
THEROUTER_MODEL="anthropic/claude-sonnet-4.5"

# AI — DeepSeek (direct, OpenAI-compatible)
# 2026-07-31 起 deepseek-v4-flash 正式版上线；旧 deepseek-chat / deepseek-reasoner 已停用
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"

# ZenMux unified model gateway (OpenAI-compatible)
ZENMUX_API_KEY=""
ZENMUX_BASE_URL="https://zenmux.ai/api/v1"
ZENMUX_MODEL="qwen/qwen3-max"

# AI — JieKou 接口AI（OpenAI 兼容中转站，内容/诊断类智能体日常分发用）
JIEKOU_API_KEY=""
JIEKOU_BASE_URL="https://api.highwayapi.ai/openai"
JIEKOU_MODEL="gpt-4o"

# AI — OpenRouter（聚合多模型，备用；深度文案官优先走 Claude）
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="qwen/qwen3.7-plus"

# AI — APIMart（OpenAI 兼容中转站，备用 GPT-5）
APIMART_API_KEY=""
APIMART_BASE_URL="https://api.apimart.ai/v1"
APIMART_MODEL="gpt-5"
APIMART_PROXY_URL=""

# AI — 离火API中转站（OpenAI-compatible，GPT-5.4/5.5/mini 等模型）
# 注册：https://api.lihuo.me/console/token
LIHUO_API_KEY=""
LIHUO_BASE_URL="https://api.lihuo.me/v1"
LIHUO_MODEL="gpt-5.5"

# AI Image — Volcengine Ark / Seedream
ARK_API_KEY=""
ARK_IMAGE_MODEL="doubao-seedream-5-0-260128"

# Video copy extraction API (server-side only)
VIDEO_TEXT_EXTRACT_API_KEY=""
VIDEO_EXTRACT_FALLBACK_ENABLED=false
VIDEO_EXTRACT_FALLBACK_URL="http://video-extractor:8080"
VIDEO_EXTRACT_FALLBACK_API_KEY=""

# Group topic capture rollout
INSPIRATION_PIPELINE_ENABLED=true
INSPIRATION_PIPELINE_SHADOW_MODE=true
WORKBUDDY_WECHAT_ENABLED=false
WECOM_INSPIRATION_ENABLED=false
WECOM_CALLBACK_TOKEN=""
WECOM_ENCODING_AES_KEY=""
WECOM_CORP_ID=""

# Aliyun speech-to-text (AIM voice input)
ALIYUN_NLS_APP_KEY=""
ALIYUN_VIAPI_ACCESS_KEY_ID=""
ALIYUN_VIAPI_ACCESS_KEY_SECRET=""

# AI — Z.AI / GLM (direct, OpenAI-compatible)
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/paas/v4/"
GLM_MODEL="glm-5.1"

# AI — OpenAI (fallback)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# ── Embedding Service (semantic knowledge retrieval) ─────
# SiliconFlow BAAI/bge-large-zh-v1.5 (free tier, great for Chinese)
# Sign up at https://siliconflow.cn to get an API key.
EMBEDDING_ENABLED=false
# 意图向量兜底：必须显式开启（不跟随 EMBEDDING_ENABLED）
# AIM_INTENT_VECTOR_FALLBACK=1
# 仅打日志不覆盖规则：AIM_INTENT_VECTOR_SHADOW=1
EMBEDDING_API_KEY=""
# Defaults below match SiliconFlow. Override for other providers.
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_MODEL="BAAI/bge-large-zh-v1.5"
EMBEDDING_DIMENSIONS=1024

# ── TikHub API (Competitor Analysis) ──────────────────
TIKHUB_API_KEY=""
TIKHUB_BASE_URL="https://api.tikhub.io"

# ── RedFox API (Competitor Watch Accounts) ────────────
REDFOX_API_KEY=""
REDFOX_BASE_URL="https://redfox.hk"
REDFOX_TIMEOUT_MS="60000"

# ── External Douyin API (Competitor Watch Accounts) ───
COMPETITOR_DOUYIN_API_URL=""
COMPETITOR_DOUYIN_API_KEY=""
COMPETITOR_DOUYIN_API_TIMEOUT_MS="60000"

# ── last30days-cn 接入配置 ──────────────────────────────
LAST30DAYS_CN_ENABLED=false
LAST30DAYS_CN_SKILL_DIR=""
LAST30DAYS_CN_CONFIG_DIR=""
LAST30DAYS_CN_TIMEOUT_MS=120000

# ── Feishu Topic Chat Bot ───────────────────────────────
# Event subscription URL: https://your-domain.com/api/integrations/feishu/events
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_VERIFICATION_TOKEN=""
FEISHU_ENCRYPT_KEY=""
FEISHU_TOPIC_PIPELINE_ENABLED=true
# First version binds one Feishu bot to one default Mingyuan user/project.
FEISHU_TOPIC_CHAT_USER_ID=""
FEISHU_TOPIC_CHAT_PROJECT_ID=""
FEISHU_TOPIC_CHAT_ID=""

# ── Feishu 经营事项执行入口（AIM × 飞书 AI 原生公司）─────
AIM_WORK_ITEM_API_SECRET=""

# eval:daily 资格制品 HMAC 签名（至少 32 字符；不要复用用户 API key）
AIM_DAILY_EVAL_ARTIFACT_SECRET=""
LARK_BASE_TOKEN=""
LARK_WORK_ITEM_TABLE_ID=""
LARK_CLI_PATH=""
# 复盘记录写出飞书多维表格（resultType=outcome 专用表；未配置时导出该类型会显式报错）
LARK_OUTCOME_TABLE_ID=""
# 多平台数据看板：社媒助手同步的飞书多维表格（账号总表 / 视频数据表，未配置返回 not_configured 空态）
LARK_PLATFORM_DATA_BASE_TOKEN=""
LARK_PLATFORM_ACCOUNT_TABLE_ID=""
LARK_PLATFORM_VIDEO_TABLE_ID=""
AIM_LOOP_NOTIFICATIONS_ENABLED=false
AIM_SUPERVISOR_CHAT_ID=""
AIM_BUSINESS_LOOPS_ENABLED=false
AIM_LOOP_SHADOW_MODE=true
AIM_LOOP_OPERATING_MODE=assisted
AIM_LOOP_PILOT_PROJECT_IDS=""
AIM_WORK_ITEM_OWNER_USER_ID=""
# 周报四段式长文（WP-D 移交项）：true 时 /api/aim/review/weekly?narrative=1 生成 AI 补写初稿（默认关）
AIM_WEEKLY_NARRATIVE_ENABLED=false

# 缺口升级：有界「先查再写」+ Skill 手册（本地可开；生产按 runbook）
AIM_BOUNDED_TOOL_LOOP_ENABLED=false
AIM_SKILL_LOADING_ENABLED=true

# 群聊选题管道（默认影子；见 docs/runbooks/gap-config-howto.md）
INSPIRATION_PIPELINE_ENABLED=true
INSPIRATION_PIPELINE_SHADOW_MODE=true
# INSPIRATION_PIPELINE_EXECUTION_MODE_OVERRIDE=evaluate
# INSPIRATION_PIPELINE_EXECUTION_MODE_OVERRIDE=live
BACKGROUND_TASKS_ENABLED=true
FEISHU_TOPIC_PIPELINE_ENABLED=false
WORKBUDDY_WECHAT_ENABLED=false
WECOM_INSPIRATION_ENABLED=false

# Harness snapshots are redacted by default. Enable only for controlled diagnostics.
AIM_STORE_SENSITIVE_SNAPSHOTS=false
LLM_MAX_PROVIDER_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=8192

# One-time destructive migration controls. Leave empty during normal operation.
ACK_RETIRE_MEDIA_DATA=""
RETIRED_MEDIA_BACKUP_REFERENCE=""

# SMS login (phone + verification code)
# console: dev only, code printed to server log; aliyun: production (console is rejected in production)
SMS_PROVIDER="console"
SMS_SIGN_NAME=""
SMS_TEMPLATE_CODE=""
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
