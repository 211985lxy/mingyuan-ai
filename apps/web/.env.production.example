# Copy to .env.production on the server.
# Do not commit the real .env.production file.

# Docker Compose database passwords
MYSQL_ROOT_PASSWORD="replace-with-strong-root-password"
MYSQL_PASSWORD="replace-with-strong-app-password"

# Runtime URLs are injected by docker-compose.prod.yml:
# DATABASE_URL=mysql://mingyuan:${MYSQL_PASSWORD}@mysql:3306/mingyuan
# REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET="replace-with-random-32-plus-chars"
ADMIN_JWT_SECRET="replace-with-random-32-plus-chars"

# Optional Obsidian sync. Both values are required when the route is enabled.
OBSIDIAN_SYNC_TOKEN=""
OBSIDIAN_SYNC_USER_ID=""

# Admin bootstrap
ADMIN_EMAIL="admin@mingyuan.ai"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# AI provider. At least one provider key is required for AIM.
THEROUTER_API_KEY=""
THEROUTER_BASE_URL="https://api.therouter.ai/v1"
THEROUTER_MODEL="anthropic/claude-sonnet-4.5"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# Optional integrations
CRON_SECRET="replace-with-random-32-plus-chars"
SHANJIAN_APP_KEY=""
SHANJIAN_BASE_URL="https://openapi.shanjian.tv"
SHANJIAN_WEBHOOK_URL=""

OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""

TIKHUB_API_KEY=""
TIKHUB_BASE_URL="https://api.tikhub.io"

COMPETITOR_DOUYIN_API_URL=""
COMPETITOR_DOUYIN_API_KEY=""
COMPETITOR_DOUYIN_API_TIMEOUT_MS="60000"
