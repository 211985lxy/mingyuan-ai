# Copy to .env.production on the server.
# Do not commit the real .env.production file.

# Docker Compose database passwords
MYSQL_ROOT_PASSWORD="replace-with-strong-root-password"
MYSQL_PASSWORD="replace-with-strong-app-password"

# Runtime URLs are injected by docker-compose.prod.yml:
# DATABASE_URL=mysql://mingyuan:${MYSQL_PASSWORD}@mysql:3306/mingyuan
# REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET="replace-with-random-32-plus-chars"
ADMIN_JWT_SECRET="replace-with-random-32-plus-chars"

# Optional Obsidian sync. Both values are required when the route is enabled.
OBSIDIAN_SYNC_TOKEN=""
OBSIDIAN_SYNC_USER_ID=""
OBSIDIAN_EXPORT_ENABLED=""
INSPIRATION_WEBHOOK_USER_ID=""

# Admin bootstrap
ADMIN_EMAIL="admin@mingyuan.ai"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# AI provider. At least one provider key is required for AIM.
THEROUTER_API_KEY=""
THEROUTER_BASE_URL="https://api.therouter.ai/v1"
THEROUTER_MODEL="anthropic/claude-sonnet-4.5"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
ZENMUX_API_KEY=""
ZENMUX_BASE_URL="https://zenmux.ai/api/v1"
ZENMUX_MODEL="qwen/qwen3-max"
# ECS 直连常超时；与 APIMART_PROXY_URL 共用本地代理即可（生产无代理将跳过 ZenMux）
ZENMUX_PROXY_URL=""
# 仅排障：允许生产无代理直连（默认勿开）
# ZENMUX_ALLOW_DIRECT=true

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

# Optional integrations
CRON_SECRET="replace-with-random-32-plus-chars"
AUDIT_INGEST_SECRET="replace-with-random-32-plus-chars"
METRICS_SCRAPE_SECRET="replace-with-random-32-plus-chars"
# Keep disabled until the deployment has an authenticated background-task scheduler.
# Must be "true" for Feishu message processing AND AIM channel conversations to work
# (both rely on the DB-backed background task queue polled by /api/cron/background-tasks).
BACKGROUND_TASKS_ENABLED="false"
INSPIRATION_PIPELINE_ENABLED="true"
# Shadow mode suppresses replies. Set "false" for live replies in production.
INSPIRATION_PIPELINE_SHADOW_MODE="true"
# Optional: capture_only | evaluate | live
# INSPIRATION_PIPELINE_EXECUTION_MODE_OVERRIDE="evaluate"

# Gap upgrade feature flags (see docs/runbooks/gap-config-howto.md)
AIM_BUSINESS_LOOPS_ENABLED="false"
AIM_LOOP_SHADOW_MODE="true"
AIM_LOOP_OPERATING_MODE="assisted"
AIM_LOOP_PILOT_PROJECT_IDS=""
AIM_LOOP_NOTIFICATIONS_ENABLED="false"
AIM_SUPERVISOR_CHAT_ID=""
AIM_BOUNDED_TOOL_LOOP_ENABLED="true"
AIM_SKILL_LOADING_ENABLED="true"

# ── Feishu (飞书) bot ──────────────────────────────────
# Get all values from https://open.feishu.cn → your bot app.
# App credentials: 应用基础信息
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
# Event subscription: 事件订阅 page → Verification Token (REQUIRED, without it the
# webhook returns 503 "Feishu verification token is not configured")
FEISHU_VERIFICATION_TOKEN=""
# Event subscription → Encrypt Key. Leave EMPTY if you did NOT enable encrypted push.
FEISHU_ENCRYPT_KEY=""
FEISHU_KNOWLEDGE_ENABLED="false"
FEISHU_KNOWLEDGE_WIKI_SPACE_IDS=""
FEISHU_KNOWLEDGE_OAUTH_REDIRECT_URI=""
# 32 字节（64 位 hex）。不要复用 FEISHU_ENCRYPT_KEY（那是飞书事件加密密钥）。
FEISHU_TOKEN_ENCRYPTION_KEY=""
FEISHU_TOPIC_PIPELINE_ENABLED="true"
# Legacy single-binding fallback (optional). If you manage bindings via the Account
# page UI instead, leave these empty. When set, the chat matching FEISHU_TOPIC_CHAT_ID
# is attributed to FEISHU_TOPIC_CHAT_USER_ID + FEISHU_TOPIC_CHAT_PROJECT_ID.
FEISHU_TOPIC_CHAT_ID=""
FEISHU_TOPIC_CHAT_USER_ID=""
FEISHU_TOPIC_CHAT_PROJECT_ID=""

WORKBUDDY_WECHAT_ENABLED="false"
WECOM_INSPIRATION_ENABLED="false"
VIDEO_EXTRACT_FALLBACK_ENABLED="false"
VIDEO_EXTRACT_FALLBACK_URL="http://video-extractor:8080"
VIDEO_EXTRACT_FALLBACK_API_KEY=""
WECOM_CALLBACK_TOKEN=""
WECOM_ENCODING_AES_KEY=""
WECOM_CORP_ID=""
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
KNOWLEDGE_UPLOAD_TEMP_DIR=""
DOCUMENT_PARSE_TIMEOUT_MS=""

# Optional AIM speech-to-text
ALIYUN_NLS_APP_KEY=""
ALIYUN_VIAPI_ACCESS_KEY_ID=""
ALIYUN_VIAPI_ACCESS_KEY_SECRET=""

# ── SMS login (phone + verification code) ─────────────
# 手机号验证码登录。生产必须用 aliyun（console 在生产环境会被拒绝）。
# 签名 + 模板需在阿里云短信控制台创建并通过审核；模板变量名必须为 ${code}。
# ALIYUN_SMS_ACCESS_KEY_* 用授了 dysmsapi:SendSms 权限的 RAM 用户 AccessKey。
SMS_PROVIDER="aliyun"
SMS_SIGN_NAME=""
SMS_TEMPLATE_CODE=""
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""

TIKHUB_API_KEY=""
TIKHUB_BASE_URL="https://api.tikhub.io"

COMPETITOR_DOUYIN_API_URL=""
COMPETITOR_DOUYIN_API_KEY=""
COMPETITOR_DOUYIN_API_TIMEOUT_MS="60000"

# ── Douyin Open Platform (网站应用 OAuth + 事件订阅 Webhook) ───
# 必须与抖音开发者后台该应用的 client_secret 完全一致，否则事件回调验签失败。
DOUYIN_CLIENT_KEY=""
DOUYIN_CLIENT_SECRET=""
DOUYIN_REDIRECT_URI="https://mingyuan-ai.cn/api/integrations/douyin/callback"
# 事件订阅 Webhook 地址：https://mingyuan-ai.cn/api/integrations/douyin/events
DOUYIN_EVENT_WEBHOOK_ENABLED="true"
AIM_STORE_SENSITIVE_SNAPSHOTS=false
LLM_MAX_PROVIDER_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=8192

# One-time destructive migration acknowledgement. Leave empty during normal operation.
ACK_RETIRE_MEDIA_DATA=""
# Sanitized record ID for the verified backup and restore drill.
RETIRED_MEDIA_BACKUP_REFERENCE=""

# ── Fish Audio TTS（语音工坊 / 创作结果配音试听）────
# 密钥从 https://fish.audio/app/api-keys 获取；留空时配音入口显示配置指引且不可用。
FISH_AUDIO_API_KEY=""
# 默认官方地址；自建代理可改这里
FISH_AUDIO_BASE_URL="https://api.fish.audio"
# 档位：s2.1-pro-free（默认免费档，无 SLA）| s2.1-pro（生产档）| s2-pro | s1
FISH_AUDIO_MODEL="s2.1-pro-free"
# 直连 api.fish.audio 超时时的出站代理；本机开发实测必须配置才可用
FISH_AUDIO_PROXY_URL=""

# Step③ HITL 对话轴门闩：开启后，对外发送/写知识库类工具动作需在对话内批准（默认关闭灰度）
AIM_HITL_INLINE_ENABLED="false"

# Step④ 首屏即对话：/aim 默认直显对话工作台；设为 "entry" 回滚到入口选择页
NEXT_PUBLIC_AIM_LANDING_DEFAULT="conversation"

# Step⑤ 组织协同：与该邮箱一致的登录用户在侧栏标记为「业务决策 + 审核」角色
NEXT_PUBLIC_ADMIN_EMAIL=""

# Step③ HITL 审批飞书通知：挂起审批时给指定群发提醒（默认关闭）
AIM_HITL_NOTIFY_ENABLED="false"
AIM_HITL_NOTIFY_CHAT_ID=""
