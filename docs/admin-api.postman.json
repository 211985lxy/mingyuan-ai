{
  "info": {
    "name": "明远AIM Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "templateId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mingyuan.ai\",\n  \"password\": \"your-password\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/templates",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"test-template\",\n  \"displayName\": \"Test Template\",\n  \"description\": \"A test template\",\n  \"scriptTemplate\": \"Hello {{name}}, welcome to {{brand}}!\",\n  \"variables\": [{\"key\": \"name\", \"label\": \"Name\", \"placeholder\": \"Your name\", \"required\": true, \"type\": \"text\"}, {\"key\": \"brand\", \"label\": \"Brand\", \"placeholder\": \"Brand name\", \"required\": true, \"type\": \"text\"}],\n  \"contentType\": \"product_intro\",\n  \"industry\": [\"电商\"],\n  \"tags\": [\"test\"]\n}"
            }
          }
        },
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/templates?page=1&pageSize=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Edit Template",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Publish Template",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}/publish",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Archive Template",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}/archive",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Restore Template",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}/restore",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Set Sort Order",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}/sort",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"sortOrder\": 100 }" }
          }
        },
        {
          "name": "Toggle Featured",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}/feature",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{ \"featured\": true }" }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/templates/{{templateId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Hot Topics Monitoring",
      "item": [
        {
          "name": "Fetch History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/hot-topics/history?page=1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Collection Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/hot-topics/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    }
  ]
}
